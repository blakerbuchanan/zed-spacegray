// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-shift-space": "terminal::ToggleViMode"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-c ctrl-t": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-`": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-c o p": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-b": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "enter": "project_panel::Open"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "unbind": {
      "space": "project_panel::Open"
    }
  },
  {
    "bindings": {
      "ctrl-c p f": "file_finder::Toggle"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-c p": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-shift-e": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-x 1": [
        "pane::CloseOtherItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "bindings": {
      "ctrl-c ctrl-a": "agent::Toggle"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-c p s": "pane::DeploySearch"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-c p s": "project_panel::NewSearchInDirectory"
    }
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "alt-cmd-shift-f": "project_panel::NewSearchInDirectory"
    }
  },
  {
    // Additional Emacs bindings missing from Zed's built-in Emacs keymap
    "context": "Editor",
    "bindings": {
      "ctrl-j": "editor::Newline", // electric-newline-and-maybe-indent
      "alt-/": "editor::ShowCompletions", // dabbrev-expand
      "alt-%": "buffer_search::DeployReplace", // query-replace
      "alt-g n": "editor::GoToDiagnostic", // next-error
      "alt-g p": "editor::GoToPreviousDiagnostic", // previous-error
      "ctrl-x ctrl-u": "editor::ConvertToUpperCase", // upcase-region
      "ctrl-x ctrl-l": "editor::ConvertToLowerCase" // downcase-region
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-x d": "project_panel::ToggleFocus" // dired
    }
  }
]
